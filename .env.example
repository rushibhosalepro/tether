# DataHub quickstart defaults. No token needed unless you enabled auth.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_TOKEN=

# Only used to DOWNGRADE a block when the diff proves the change is safe.
# Tether blocks fine without it. Set TETHER_NO_LLM=1 to skip the call entirely.
ANTHROPIC_API_KEY=
TETHER_NO_LLM=0

# Needed only when posting the check run outside GitHub Actions
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Serve recorded fixtures instead of a live DataHub. The demo survives dead Docker.
DEMO_MODE=0
TETHER_RECORD=0
